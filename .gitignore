# =============================================================================
# TG-Desk CRM — repository .gitignore
# =============================================================================

# ------------------------------------------------------------------ Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
sdist/
wheels/
.venv/
venv/
ENV/
env.bak/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
htmlcov/
.coverage
.coverage.*
coverage.xml
.tox/
.nox/
hypothesis/

# -------------------------------------------------------------------- Node ---
node_modules/
.npm/
.pnpm-store/
dist/
.vite/
*.tsbuildinfo

# --------------------------------------------------------------------- Env ---
# Root .env holds real secrets; the template stays tracked.
.env
.env.*
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------- Logs & runtime data ---
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed_manual
backend/tgdesk.db
*.sqlite
*.sqlite3

# Downloaded Telegram media. Contains client conversations — never publish.
storage/
media/

# Database dumps taken before maintenance. They carry live customer data.
backups/

# --------------------------------------------------------------- Telethon ---
# Session files are equivalent to a logged-in Telegram account — never commit.
*.session
*.session-journal

# ------------------------------------------------------- Local QA artefacts ---
# Playwright screenshots and any ad-hoc diagnostic scripts written during QA.
ui-shots/
_*_diag*.cjs
_diag_*.cjs
diag-*.png

# ------------------------------------------------------------- OS / IDE ------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ------------------------------------------------------------------ Docker ---
# Local compose overrides (keep docker-compose.dev.yml tracked).
docker-compose.override.yml
docker-compose.*.local.yml

# ------------------------------------------------- Verification scratch space ---
# Screenshots and helper tooling produced while QA-ing the UI; never committed.
.devtools/

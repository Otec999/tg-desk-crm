# =============================================================================
# TG-Desk CRM — backend environment template
# =============================================================================
# The backend does NOT read this file directly. It loads the ROOT `.env`
# (../.env) via python-dotenv, so that the SAME values are shared with
# docker-compose.dev.yml and the Telethon worker — one file, one truth.
#
# This file exists only as a reference: it lists the keys the backend actually
# consumes, so you can see at a glance what it needs. To change a value, edit
# the ROOT `.env` (copy ../.env.example first if `.env` does not exist yet):
#
#   PowerShell : Copy-Item ..\.env.example ..\.env
#   bash/zsh   : cp ../.env.example ../.env
#
# If you really need per-backend overrides, either:
#   * export them in the shell before `uvicorn ...` (they win over .env), or
#   * create backend/.env — ONLY if app/core/config.py explicitly loads it;
#     otherwise it is silently ignored.
# =============================================================================

# ---- PostgreSQL (host: 5433 -> container: 5432) ----
POSTGRES_USER=tgcrm
POSTGRES_PASSWORD=tgcrm_pass
POSTGRES_DB=tgcrm
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Derived by the app (do NOT set unless you want to override the assembly):
# postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_URL=redis://localhost:6380/0

# ---- Backend / auth ----
BACKEND_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=720
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_SLA_SECONDS=300
BACKEND_WS_HEARTBEAT_TIMEOUT_SECONDS=45
BACKEND_WS_TICK_SECONDS=2
BACKEND_SUPERVISOR_USERNAME=admin
BACKEND_SUPERVISOR_PASSWORD=admin123
BACKEND_SEED_OPERATOR_PASSWORD=operator123

# ---- Admin adapters (tx lookup; mock values in dev) ----
ADMIN_ONE_BASE_URL=https://admin-one.internal.example/api
ADMIN_ONE_API_KEY=mock-admin-one-key
ADMIN_TWO_BASE_URL=https://admin-two.internal.example/api
ADMIN_TWO_API_KEY=mock-admin-two-key

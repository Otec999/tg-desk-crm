# =============================================================================
# TG-Desk CRM — frontend (Vite) environment template
# =============================================================================
# Vite only exposes variables prefixed with `VITE_`, and it reads THIS folder's
# `.env*` files — not the root one. That is why these three keys are duplicated
# here instead of being pulled from the root `.env` (no server secrets ever
# reach the browser bundle).
#
# Copy to `.env` (or `.env.local`) for local overrides — both are git-ignored:
#   PowerShell : Copy-Item .env.example .env
#   bash/zsh   : cp .env.example .env
#
# The backend/database settings stay in the ROOT `.env` (see ../.env.example);
# the frontend never needs them.
#
# CONTRACTS §0:
#   Frontend dev server  http://localhost:5173
#   Backend REST         http://localhost:8000/api   (api.ts appends /api)
#   Backend WebSocket    ws://localhost:8000/ws?token=<jwt>
# =============================================================================

# FastAPI backend origin — REST base, NO trailing slash and NO /api suffix
# (the typed client in src/lib/api.ts appends /api itself).
VITE_API_URL=http://localhost:8000

# WebSocket base of the same backend — ws.ts appends /ws?token=<jwt>.
VITE_WS_URL=ws://localhost:8000/ws

# "true"  => the UI boots from the bundled mock dataset (src/lib/mockData.ts),
#            no backend required.
# "false" => always use the live API above (default for the integrated stack).
# Unset   => auto-detect: falls back to mock when the backend is unreachable,
#            which is handy for design previews.
VITE_MOCK_MODE=false

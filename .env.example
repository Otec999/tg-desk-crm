# =============================================================================
# TG-Desk CRM — environment template (repo root)
# =============================================================================
# Copy this file to `.env` and you are done — every default below matches
# docker-compose.dev.yml and CONTRACTS.md §1, so the stack boots with ZERO
# editing:
#
#   PowerShell : Copy-Item .env.example .env
#   bash/zsh   : cp .env.example .env
#
# `.env` is git-ignored; this `.env.example` is committed.
# The backend loads this file via python-dotenv (backend reads `../.env`).
# Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL  (docker-compose.dev.yml: service `postgres`, host port 5433)
# POSTGRES_HOST/PORT are what the NATIVE backend uses; the container always
# listens on 5432 internally. Set POSTGRES_HOST=postgres only if you also run
# the backend inside Compose.
# -----------------------------------------------------------------------------
POSTGRES_USER=tgcrm
POSTGRES_PASSWORD=tgcrm_pass
POSTGRES_DB=tgcrm
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# Redis  (docker-compose.dev.yml: service `redis`, host port 6380)
# If you change REDIS_PORT, keep this URL in sync.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# BACKEND_SECRET_KEY: JWT signing key — MUST be replaced before any non-local
# deployment. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
# BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=720 -> 12h, matches CONTRACTS §3.1
#   (expires_in 43200).
# BACKEND_CORS_ORIGINS: comma-separated, no spaces.
# BACKEND_SLA_SECONDS: first-response SLA target (5 min), mirrored per operator
#   in the `operators.sla_target_seconds` column.
# BACKEND_WS_*: websocket heartbeat timeout and SLA ticker interval.
# BACKEND_SUPERVISOR_* / BACKEND_SEED_OPERATOR_PASSWORD: used by backend/seed.py
# -----------------------------------------------------------------------------
BACKEND_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=720
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_SLA_SECONDS=300
BACKEND_WS_HEARTBEAT_TIMEOUT_SECONDS=45
BACKEND_WS_TICK_SECONDS=2
BACKEND_SUPERVISOR_USERNAME=admin
BACKEND_SUPERVISOR_PASSWORD=admin123
BACKEND_SEED_OPERATOR_PASSWORD=operator123

# Admin panel (CONTRACTS_V2 §3.3) — a SEPARATE login form at /admin.
# Only accounts with role ADMIN (or SUPERVISOR for read-only) may sign in here;
# a normal operator token is rejected with 401 on every /api/admin/* route.
# BACKEND_ADMIN_SESSION_TTL_MINUTES: lifetime of an admin token (default 480 = 8h).
# BACKEND_SECRET_BOX_KEY: Fernet key used to encrypt `telegram_accounts.api_hash`
#   and `session_string` at rest. When empty, a key is derived from
#   BACKEND_SECRET_KEY via SHA-256 — rotating that secret then makes existing
#   stored sessions unreadable, so set a dedicated value for real deployments.
#   Generate one with:
#     python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BACKEND_ADMIN_SESSION_TTL_MINUTES=480
BACKEND_SECRET_BOX_KEY=

# -----------------------------------------------------------------------------
# Admin adapters — transaction lookup panels (MOCK values for dev).
# Real credentials go here later; the code path is identical.
# -----------------------------------------------------------------------------
ADMIN_ONE_BASE_URL=https://admin-one.internal.example/api
ADMIN_ONE_API_KEY=mock-admin-one-key
ADMIN_TWO_BASE_URL=https://admin-two.internal.example/api
ADMIN_TWO_API_KEY=mock-admin-two-key

# -----------------------------------------------------------------------------
# Telethon worker (telethon_worker/worker.py — runs natively on the host)
# TG_API_ID / TG_API_HASH: from https://my.telegram.org -> API development tools
# TG_SESSION_STRING / TG_STRING_SESSION: leave EMPTY in dev to log in
#   interactively once and persist TG_SESSION_FILE (`*.session` is git-ignored).
# TG_SESSION_FILE: relative to the repo root.
# TG_MONITORED_CHAT_IDS: comma-separated tg_chat_id values, e.g.
#   -1001234567890,-1009876543210  (empty = listen to every dialog)
# TELEGRAM_*: optional internal notification target(s) for the worker.
#   TELEGRAM_ADMIN_CHAT_IDS is a comma-separated list; TELEGRAM_ADMIN_CHAT_ID
#   is the single-value legacy form.
# -----------------------------------------------------------------------------
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION_STRING=
TG_STRING_SESSION=
TG_SESSION_FILE=./telethon_worker/tg_desk.session
TG_MONITORED_CHAT_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=

# -----------------------------------------------------------------------------
# Media store (CONTRACTS_V2 §5/§7).
# MEDIA_ROOT: where the worker downloads attachments AND where the backend stores
#   files uploaded by operators. media_attachments.storage_path is stored RELATIVE
#   to this folder, so backend and worker must see the same one.
#   A relative value is resolved against the repository root.
# MAX_DOWNLOAD_BYTES: ceiling for one attachment the WORKER downloads (default
#   50 MiB). Accepts 52428800, 50MB or 1.5GiB. Larger files are reported to the
#   CRM but not saved.
# MAX_UPLOAD_BYTES: ceiling for one file an OPERATOR uploads through the UI
#   (default 25 MiB). Enforced from Content-Length before the body is read.
# -----------------------------------------------------------------------------
MEDIA_ROOT=storage/media
MAX_DOWNLOAD_BYTES=52428800
MAX_UPLOAD_BYTES=26214400
